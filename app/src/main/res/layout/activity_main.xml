<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/top_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#121826"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nút Dịch Phụ Đề (Mặc định ẩn GONE khi chưa có video) -->
        <Button
            android:id="@+id/btn_translate_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#8B5CF6"
            android:text="Dịch Phụ Đề"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Nút Xuất video (Mặc định ẩn GONE khi chưa có video) -->
        <Button
            android:id="@+id/btn_export_video"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#10B981"
            android:text="Xuất video"
            android:textColor="#0A0E1A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Compose Container hiển thị toàn bộ giao diện tương tác động -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar_layout" />

    <!-- Fallback Layout Components tham chiếu -->
    <LinearLayout
        android:id="@+id/layout_empty_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <!-- Nút Chọn hoặc Tải Video -->
        <Button
            android:id="@+id/btn_select_video"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_select_video"
            android:text="+ Chọn hoặc Tải Video"
            android:textColor="#0A0E1A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Nút Liên hệ ADMIN: Nằm ngay dưới nút chọn video, viền Cyan, nền trong suốt -->
        <Button
            android:id="@+id/btn_contact_admin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_contact_admin"
            android:text="💬 Liên hệ ADMIN"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
